# Used by `pnpm dev` / `pnpm db:migrate` (loaded from the repo root .env).
DATABASE_URL=postgres://competitor_pulse:competitor_pulse@localhost:5434/competitor_pulse

# LLM: defaults to the bundled mock server. For OpenAI set
# LLM_BASE_URL=https://api.openai.com/v1 and a real LLM_API_KEY.
LLM_BASE_URL=http://localhost:4001/v1
LLM_API_KEY=mock-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=15000

# Scheduler: production would use 900000 (15 min); short for demos.
POLL_INTERVAL_MS=30000
POLL_CONCURRENCY=10

SUMMARY_POLL_INTERVAL_MS=2000
SUMMARY_BATCH_SIZE=10
SUMMARY_MAX_ATTEMPTS=5
SUMMARY_RETRY_BASE_DELAY_MS=5000

LOG_LEVEL=info
